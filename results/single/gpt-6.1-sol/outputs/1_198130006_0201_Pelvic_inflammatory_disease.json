        "code": {
          "text": "Mycoplasma genitalium infection"
        },
        "note": [
          {
            "text": "Detected on prior vaginal NAAT shown in a photograph. Concern for persistence after the standard PID regimen; no prior test of cure. Clinician assesses a need for targeted therapy and test of cure."
          }
        ]
      }
    },
