        "code": {
          "text": "Recent chlamydia infection, treatment completed"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "note": [
          {
            "text": "Diagnosed by vaginal NAAT approximately 3 weeks before the visit following routine screening after a new partner. Doxycycline course completed approximately 2 weeks before the visit. Follow-up CT NAAT was negative."
