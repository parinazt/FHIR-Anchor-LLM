          "text": "Likely methamphetamine-induced psychosis, now resolved"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "resolved"
            }
          ]
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "note": [
          {
            "text": "ED episode approximately 2 weeks ago with a clear temporal link to heavy stimulant use. Symptoms settled over approximately 24–36 hours. Assessment states symptoms resolved for more than 2 weeks, with no ongoing psychotic features today. A primary psychotic disorder is not clear at this stage."
          }
        ]
      }
