        "resourceType": "Condition",
        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Focal epilepsy with secondary generalization"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Known epilepsy, well controlled on levetiracetam. No generalized tonic-clonic seizures since the admission approximately 18 months ago. Two early post-event auras, none for approximately 9–10 months. Currently stable with no red flags; ongoing antiepileptic treatment indicated to reduce recurrence risk, including further status epilepticus."
          }
        ]
      }
    },
