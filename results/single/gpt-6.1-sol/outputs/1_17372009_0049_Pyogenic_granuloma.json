        "code": {
          "text": "Pyogenic granuloma of right index finger"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "bodySite": [
          {
            "text": "Dorsal right index finger near proximal interphalangeal joint"
          }
        ],
        "onsetString": "Onset approximately 5–6 weeks ago after a paper cut, with a red lump developing over approximately 2 weeks.",
        "note": [
          {
            "text": "Previously assessed as likely pyogenic granuloma at the consultation documented 15/11/25. Current assessment describes a benign vascular lesion, likely following minor trauma, with symptomatic recurrent bleeding affecting work and causing cosmetic concern. Histopathological confirmation is planned."
          }
        ]
      }
