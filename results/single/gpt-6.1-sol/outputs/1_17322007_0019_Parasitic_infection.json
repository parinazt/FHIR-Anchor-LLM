    {
      "fullUrl": "https://example.org/fhir/Condition/condition-1",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Likely new-onset episodic tension-type headache"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "onsetString": "Gradual onset approximately 7 days before the visit",
        "note": [
          {
            "text": "Bilateral pressure-like, mild-to-moderate, non-pulsatile headache. Clinician assessed occupational stress, reduced sleep, probable dehydration and screen use as contributing factors. Red-flag screen negative; serious intracranial pathology and neurocysticercosis considered very unlikely."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Possible intestinal helminth infection, threadworm versus another travel-related helminth"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "note": [
          {
            "text": "Change in bowel habit, mild bloating, increased stool frequency and intermittent nocturnal perianal itch after travel. Strongyloides and hookworm considered less likely clinically. Investigation planned with empiric threadworm treatment."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Probable dehydration contributing to headache"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "note": [
          {
            "text": "Suboptimal hydration during long shifts in a hot kitchen."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Headache characteristics and course"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Headache for approximately 1 week, with gradual onset approximately 7 days ago. Dull, band-like pressure over the temples and forehead, occasionally the occiput; bilateral and non-pulsatile. Builds over the day, worse late in the day after long hot kitchen shifts and late-night screen use, settles overnight, and does not cause early-morning waking."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Headache severity"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "4–6/10"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Headache relieving factors"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Relieved by paracetamol 1 g up to twice daily as needed, rest and a dark room."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Photophobia"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Mild photophobia when very tired."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Headache-associated symptoms and red-flag screening"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No nausea, vomiting, visual aura, focal neurological symptoms, speech change, sensory loss, fever, neck stiffness, rash, confusion or seizures. No thunderclap or 'worst ever' headache, personality or cognitive change, visual field loss, diplopia or jaw claudication. No recent head trauma."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Patient concerns about headache"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Patient questions whether dehydration from working at the pass all night is contributing and is very concerned about parasites, particularly neurocysticercosis, after reading online."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Travel and infection history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Returned from a 3-week trip to Mumbai and Goa approximately 3 months ago. No malaria prophylaxis. No acute febrile illness during travel or on return, and no history of febrile illness since return."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
