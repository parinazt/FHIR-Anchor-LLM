        "status": "final",
        "code": {
          "text": "Historical loose stools"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Had 2–3 days of loose stools in the travel/return history; self-resolved."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
