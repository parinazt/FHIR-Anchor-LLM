        "status": "final",
        "code": {
          "text": "Abdominal symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Intermittent crampy lower abdominal discomfort and mild bloating over the last 2–3 weeks."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
