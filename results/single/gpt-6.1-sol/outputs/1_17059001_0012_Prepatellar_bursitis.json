              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Type 2 diabetes mellitus, likely poorly controlled"
        },
        "note": [
          {
            "text": "Poor control is suspected, not established by current laboratory results. Medication non-adherence and no recent monitoring; last review approximately 9 months ago. Pathology results not yet available."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Work and functional limitation associated with right knee symptoms"
        },
        "note": [
          {
            "text": "Limited kneeling, squatting and stair use on flare days. Still able to work, but limited for heavy floor tiling. Permanent incapacity for all work was not certified."
          }
        ]
      }
    },
