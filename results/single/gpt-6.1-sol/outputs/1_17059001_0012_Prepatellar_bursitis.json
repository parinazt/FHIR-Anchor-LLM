        "code": {
          "text": "Chronic non-septic right prepatellar bursitis, occupational from repetitive kneeling"
        },
        "note": [
          {
            "text": "Clinically assessed as non-septic. Swelling present approximately 3–4 months, worse over the last 4–6 weeks."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
