        "code": {
          "text": "Likely functional bowel disorder: functional diarrhoea / IBS-D spectrum with subjective bloating"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "note": [
          {
            "text": "Chronic loose stools and bloating for more than 6 months, minimal pain, previously normal blood and stool investigations including faecal calprotectin. Sensation of swelling without objective oedema or signs of cardiac, renal or liver failure. No current red flags on history or examination."
          }
        ]
      }
    },
