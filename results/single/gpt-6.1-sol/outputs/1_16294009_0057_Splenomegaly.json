    {
      "fullUrl": "https://example.org/fhir/Condition/condition-1",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "HFE haemochromatosis, C282Y homozygote"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Known HFE haemochromatosis; iron indices assessed as satisfactory. Ongoing risk of fibrosis, cirrhosis and hepatocellular carcinoma, not diagnoses of these complications."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Splenomegaly"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Mild increase in spleen size from 14.8 to 15.5 cm over 12 months; likely secondary to portal hypertension/chronic liver disease in the context of haemochromatosis. Platelets low-normal only; no current red flags."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Possible chronic liver disease, related to haemochromatosis with or without metabolic/fatty liver disease"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "note": [
          {
            "text": "Assessed in the context of mild liver function test abnormalities and ultrasound fatty change; fibrosis staging needed."
          }
        ]
      }
    },
