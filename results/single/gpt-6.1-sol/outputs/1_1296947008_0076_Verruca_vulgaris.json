        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Salicylic acid wart paint"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Continue on the right thumb and start the same paint on the left index finger. Soak for 5–10 minutes, pare with an emery board, protect normal skin, apply paint, then occlude. Continue nightly up to a total of 3 months before calling treatment failure.",
            "site": {
              "text": "Right thumb and left index finger warts"
            },
            "timing": {
              "repeat": {
                "frequency": 1,
