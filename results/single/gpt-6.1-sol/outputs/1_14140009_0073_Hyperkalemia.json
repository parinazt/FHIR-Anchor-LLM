        "code": {
          "text": "Acute-on-chronic mechanical low back pain, likely muscular/degenerative strain on background osteoarthritis-type changes"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Longstanding intermittent mechanical low back pain; current flare worsened over the last 5–6 days. Muscular/degenerative cause is considered likely. No red flags identified on history or limited telehealth assessment."
          }
        ]
      }
    },
