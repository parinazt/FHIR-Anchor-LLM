      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Checking behavior and catastrophic worries"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Repetitive checking of partner's location and messages; worries something bad will happen and he will not come home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Avoidance and functional limitations"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Avoids being alone outside home, public transport and busy indoor spaces alone. Cancels or delays appointments if partner cannot accompany her and uses grocery delivery. Can walk a short distance around the block with partner. Telehealth is acceptable; unfamiliar places alone cause high distress. Reports remote work permits avoidance of going anywhere."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Sleep difficulty and nightmares"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Difficulty sleeping when partner is not in the flat; waits awake until he returns. Occasional nightmares about partner going missing or having an accident."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
