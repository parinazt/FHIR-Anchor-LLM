          "text": "Separation-associated somatic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Abdominal tightness, nausea and mild headache when partner is about to leave; symptoms settle when he is home."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
