        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "onsetString": "Longstanding",
        "note": [
          {
            "text": "Uses bilateral behind-the-ear hearing aids. Possible gradual progression with transient reduction in hearing during current URTI congestion. Last audiology approximately 2 years ago."
