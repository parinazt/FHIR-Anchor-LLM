        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Generalized anxiety disorder, chronic, with current moderate exacerbation"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Difficulty controlling worry, prominent health anxiety and reassurance seeking. Partial response to sertraline 50 mg. Exacerbation considered likely multifactorial in the context of dementia-related uncertainty, increased internet searching and poor sleep hygiene."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
