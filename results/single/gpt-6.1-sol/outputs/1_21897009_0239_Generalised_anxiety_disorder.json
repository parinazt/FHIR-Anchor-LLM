          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Known mild–moderate dementia, likely Alzheimer type"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Diagnosed through the memory clinic approximately 2 years ago. Appears gradually progressive, with subjective slight decline. Alzheimer etiology described as likely in the history. No signs of acute deterioration today."
          }
        ]
      }
    },
