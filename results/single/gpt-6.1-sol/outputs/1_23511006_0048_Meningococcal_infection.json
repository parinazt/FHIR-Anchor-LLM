        "code": {
          "text": "Recent invasive meningococcal disease due to Neisseria meningitidis serogroup B"
        },
        "note": [
          {
            "text": "Diagnosed during recent hospital admission with meningitis and septicaemia. Approximately day 9 after onset and day 4 after discharge at this encounter. Completed adequate IV ceftriaxone treatment; clinically stable and not considered infectious now."
          }
        ]
      }
    },
