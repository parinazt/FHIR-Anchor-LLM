    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-1",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-1",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Betamethasone dipropionate 0.05% ointment (Diprosone)"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "sequence": 1,
            "text": "For the current flare, apply twice daily to affected hand areas for 7 days; use on rash only.",
            "route": {
              "text": "Topical"
            },
            "site": {
              "text": "Affected hand areas"
            },
            "timing": {
              "repeat": {
                "boundsDuration": {
                  "value": 7,
                  "unit": "days",
                  "system": "http://unitsofmeasure.org",
                  "code": "d"
                },
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          },
          {
            "sequence": 2,
            "text": "Then apply once daily for 7 days, then stop. Use on rash only.",
            "route": {
              "text": "Topical"
            },
            "site": {
              "text": "Affected hand areas"
            },
            "timing": {
              "repeat": {
                "boundsDuration": {
                  "value": 7,
                  "unit": "days",
                  "system": "http://unitsofmeasure.org",
                  "code": "d"
                },
                "frequency": 1,
                "period": 1,
                "periodUnit": "d"
              }
            }
          }
        ],
        "note": [
          {
            "text": "Avoid potent steroid on face and flexures."
          }
        ]
      }
    },
