      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-1",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Occupational hand dermatitis secondary to mixed irritant and probable allergic contact with hairdressing chemicals and occlusive glove use"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Known occupational hand dermatitis; seen approximately 6 months ago for similar symptoms. Mild-to-moderate flare today, not infected. Allergic contact contribution is probable."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Localized contact urticaria pattern at glove edge"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "note": [
          {
            "text": "Possible latex or rubber chemical allergy, not yet confirmed. No active wheals on examination."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Mild psoriasis"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Longstanding mild plaques of scalp and elbows. Currently stable with mild scalp scale. Assessed as contributing to increased background skin sensitivity."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported hand rash flares"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Increasing flares over the last 6–8 weeks: dorsal hands and fingers become red, dry and fissured, with some small vesicles at the end of long bleach/dye days.",
        "note": [
          {
            "text": "Patient reports repeatedly reacting to substances at work and requests something stronger to allow continued working."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Hand itching and burning"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Itching and burning worse at the end of the shift; somewhat better on days off."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Reported transient welts at glove edge"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "New raised, itchy welts on wrists and forearms shortly after contact with wet hair/dye where gloves end; settle in 1–2 hours without treatment. Patient describes little hive lines where gloves stop."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Forearm stinging and redness with sun exposure"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports more stinging and redness on sun-exposed forearms when going outside for lunch after certain products; possible photo component."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Occupational skin exposures"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Full-time hairdresser in a metropolitan salon with high client turnover and wet work. Uses powdered latex gloves most of the time; hands are damp underneath. Nitrile gloves are available but patient finds them inconvenient when busy. Frequent handwashing with standard liquid soap and hot water."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "New personal product exposure at home"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Denies new personal products at home. Patient queries new dishwasher tablets or coffee at work as possible triggers; these are not established causes."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-7",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-7",
        "status": "final",
        "code": {
          "text": "Reported respiratory and systemic allergic symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No shortness of breath, wheeze, facial or tongue swelling, or generalized urticaria."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-8",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-8",
        "status": "final",
        "code": {
          "text": "Reported negative past medical history"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No history of asthma, allergic rhinitis or anaphylaxis."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-9",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-9",
        "status": "final",
        "code": {
          "text": "Painful fissures and functional impact"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Painful fissures make shampooing and colouring difficult. Still working full time; worried that ongoing symptoms may prevent working."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-10",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-10",
        "status": "final",
        "code": {
          "text": "Adherence barriers"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Time-poor patient with limited adherence to prevention due to work pressures. Reports only having 10 minutes. Initially reluctant about dermatology assessment because of difficulty taking time off, but agreed if booked ahead."
      }
    },
