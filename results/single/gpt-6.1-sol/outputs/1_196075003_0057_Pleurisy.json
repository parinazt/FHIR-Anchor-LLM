        "code": {
          "text": "Likely tension-type headache, possibly stress/sleep-related"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "note": [
          {
            "text": "No red flags today; neurological examination normal. Low suspicion for SAH, meningitis, space-occupying lesion or CVT."
          }
        ]
      }
    },
    {
