        },
        "code": {
          "text": "Recent pleurisy with persistent pleuritic chest pain"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Patient reports diagnosis of pleurisy at Wagga ED approximately one week ago. ED records have not been received. Clinician assesses haemodynamic stability and low suspicion for PE, pneumothorax or pneumonia today."
          }
        ]
      }
    },
