        "code": {
          "text": "Stress urinary incontinence, persistent, mild to moderate; likely multifactorial"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "note": [
          {
            "text": "Known from the previous visit approximately 3 months ago; listed as a working diagnosis today. Assessed contributors include parity, pelvic floor weakness, postmenopause, an on-feet job and increased BMI. No features of overactive bladder, overflow or UTI."
          }
        ]
      }
