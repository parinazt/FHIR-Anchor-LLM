              "code": "provisional"
            }
          ]
        },
        "onsetString": "Noticed approximately 4–5 weeks before this visit, after a nick with a box cutter",
        "bodySite": [
          {
            "text": "Dorsolateral right index finger, just distal to the proximal interphalangeal joint"
          }
        ],
        "note": [
          {
            "text": "Typical appearance of a small vascular lesion at a prior trauma site. Assessed as benign but functionally limiting at work because of recurrent bleeding during manual tasks. Histopathological confirmation is planned to exclude amelanotic melanoma or another vascular lesion; suspicion is low."
          }
        ]
      }
