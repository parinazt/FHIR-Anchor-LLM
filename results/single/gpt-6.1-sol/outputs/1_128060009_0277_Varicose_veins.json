        "code": {
          "text": "Superficial venous thrombosis of the right medial calf over a varicose vein"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Clinical assessment: uncomplicated, without systemic features, cellulitis, or DVT/PE symptoms. Estimated length 7–8 cm; location relative to SFJ/SPJ uncertain. Duplex ultrasound pending to confirm extent, assess junction distance, and exclude DVT."
