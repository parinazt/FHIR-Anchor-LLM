        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "effectiveDateTime": "2025-11-22",
        "valueString": "New dull, tight ache in the central to slightly right-sided mid–lower back, without radiation to the legs. Gradual onset approximately 5–6 days ago, with no clear injury."
