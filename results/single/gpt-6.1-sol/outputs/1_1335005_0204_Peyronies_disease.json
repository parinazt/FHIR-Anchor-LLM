        "code": {
          "text": "Mechanical mid–lower back pain"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "recordedDate": "2025-11-22",
        "onsetString": "Gradual onset approximately 5–6 days ago",
        "note": [
          {
            "text": "Likely muscular or soft tissue strain related to physical workload, possibly also a new firm mattress and driving on a rough farm road. Assessed as uncomplicated by history, with no concerning red flag features elicited. Telehealth assessment only; no physical examination."
          }
        ]
      }
    },
