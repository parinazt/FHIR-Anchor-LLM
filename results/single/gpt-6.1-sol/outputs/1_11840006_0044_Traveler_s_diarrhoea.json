        },
        "valueRange": {
          "low": {
            "value": 5,
            "unit": "/10"
          },
          "high": {
            "value": 6,
            "unit": "/10"
          }
        },
        "note": [
          {
            "text": "Patient reports approximately 5–6/10."
          }
        ]
      }
    },
    {
