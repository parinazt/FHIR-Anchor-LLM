        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Previously documented health anxiety; currently contributing to increased distress and requests for over-investigation."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Low back pain characteristics"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Gradual onset over 2 days; central low back pain across the belt line with aching and stiffness. Worse with bending and standing from sitting; improves somewhat lying flat. Non-radiating, with no leg symptoms. Started after a day of increased toilet trips; patient queried straining as a cause."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
