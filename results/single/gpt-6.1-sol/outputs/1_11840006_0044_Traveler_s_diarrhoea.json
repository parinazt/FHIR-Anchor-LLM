        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Acute nonspecific mechanical low back pain, likely muscular/postural"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "onsetString": "Gradual onset 2 days before the encounter",
        "note": [
          {
            "text": "Assessed as likely related to travel, poor mattress, prolonged plane sitting and toilet posture. No current features of spinal infection, fracture, cancer or disc disease with nerve compression."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Acute travellers diarrhoea, likely self-limiting infective gastroenteritis"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "severity": {
          "text": "Mild to moderate"
        },
        "onsetString": "Loose stools began approximately 24 hours after returning from Bali; returned 5 days before the encounter",
        "note": [
          {
            "text": "Returned traveller with no current red flags; infective gastroenteritis is the likely aetiology."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
