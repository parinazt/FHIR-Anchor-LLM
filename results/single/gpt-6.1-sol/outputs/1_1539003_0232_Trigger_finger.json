        "code": {
          "text": "Trigger finger of the right ring finger (stenosing tenosynovitis)"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Classic history and examination; symptoms for 4–5 months. No red flags; investigations reassuring, with no evidence of inflammatory arthropathy, gout or sepsis."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Right ring finger pain"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Present for 4–5 months; pain up to 7/10, although patient describes it as only a bit sore. Worse with long days of paperwork, phone use and lifting grandchildren."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Reported right ring finger locking and stiffness"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Catching and locking for 4–5 months, especially in the morning. Stiffness lasts 10–15 minutes then eases. Sometimes needs the left hand to straighten the finger. Clicking and popping reported."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
