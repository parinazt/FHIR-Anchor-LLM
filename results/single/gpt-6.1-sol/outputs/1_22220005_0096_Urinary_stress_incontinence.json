        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Likely benign pelvic awareness, possibly related to anxiety"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "note": [
          {
            "text": "Reported suprapubic tenderness was not reproduced on examination. Normal observations, negative urine dipstick and no systemic symptoms; assessed as likely benign pelvic awareness with possible anxiety contribution rather than UTI, malignancy or an acute abdominal cause."
          }
        ]
      }
    },
