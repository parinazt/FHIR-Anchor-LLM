          "text": "Stress urinary incontinence"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Postmenopausal; persistent but stable, consistent with pelvic floor weakness. Seen approximately 3 weeks previously and started pelvic floor exercises and lifestyle advice."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
