        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Viral upper respiratory tract infection diagnosed last week"
        },
        "note": [
          {
            "text": "Diagnosed at the previous visit last week; no antibiotics given. Resolution of the infection is not explicitly documented."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Subacute cough, likely post-viral"
        },
        "note": [
          {
            "text": "Approximately two weeks in duration. Possible additional mild upper airway irritation from dust or post-nasal drip. No red flags today; examination and vital signs reassuring."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Possible mild upper airway irritation or post-nasal drip contributing to cough"
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "note": [
          {
            "text": "Occupational and environmental irritants, including dusty work sites and an old heater, are assessed as probably contributing."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-4",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-4",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Hirschsprung disease"
        },
        "note": [
          {
            "text": "Known Hirschsprung disease, with surgery in childhood and ongoing bowel management."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-5",
      "resource": {
        "resourceType": "Condition",
