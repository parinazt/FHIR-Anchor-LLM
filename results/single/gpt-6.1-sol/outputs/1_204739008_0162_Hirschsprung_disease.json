        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "reasonCode": [
          {
            "text": "Possible post-nasal drip contributing to cough"
          }
        ],
        "dosageInstruction": [
          {
            "text": "Trial cetirizine 10 mg at night for 7–10 days.",
            "timing": {
              "repeat": {
                "frequency": 1,
                "period": 1,
                "periodUnit": "d",
                "when": [
                  "NIGHT"
                ]
              }
            },
            "doseAndRate": [
              {
                "doseQuantity": {
                  "value": 10,
                  "unit": "mg"
                }
              }
            ],
            "patientInstruction": "May cause some drowsiness. See how you respond to the first dose before driving."
          }
        ],
        "note": [
          {
            "text": "Advised to buy over the counter; PBS availability if prescribed was discussed, but no formal prescription issuance is documented."
