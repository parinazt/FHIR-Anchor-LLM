    {
      "fullUrl": "https://example.org/fhir/MedicationRequest/medication-request-2",
      "resource": {
        "resourceType": "MedicationRequest",
        "id": "medication-request-2",
        "status": "active",
        "intent": "order",
        "medicationCodeableConcept": {
          "text": "Movicol"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "reasonCode": [
          {
            "text": "Constipation with recent harder, less frequent stools"
          }
        ],
        "dosageInstruction": [
          {
            "text": "May increase Movicol up to 2–3 sachets/day short term if more than two days without a bowel movement or if stool is hard, then reduce back to the usual dose once daily soft stools return.",
            "asNeededBoolean": true,
            "patientInstruction": "Increase only if more than two days without a bowel movement or stool is hard. Return to the usual dose once daily soft stools resume."
          }
        ],
        "note": [
          {
            "text": "Conditional short-term dose adjustment to existing Movicol treatment."
