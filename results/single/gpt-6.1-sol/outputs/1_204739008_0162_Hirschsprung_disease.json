              "code": "active"
            }
          ]
        },
        "code": {
          "text": "Chronic post-surgical constipation associated with Hirschsprung disease"
        },
        "note": [
          {
            "text": "Currently reasonably controlled, with mild slowing during the recent illness. No features of obstruction or megacolon."
          }
        ]
      }
    },
