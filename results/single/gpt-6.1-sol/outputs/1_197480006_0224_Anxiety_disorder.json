      "resource": {
        "resourceType": "Condition",
        "id": "condition-1",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Generalised anxiety disorder, chronic, currently mild–moderate"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Long-standing; increased after moving to the RACF two years ago. Likely exacerbated by health anxiety, dementia-related uncertainty and online health information. No red flags for an acute organic cause today."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-2",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Major depressive disorder in partial remission"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "remission"
            }
          ]
        },
        "note": [
          {
            "text": "Mood fairly stable on sertraline and mirtazapine for more than 12 months. Age and dementia increase the risk of relapse."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-3",
      "resource": {
        "resourceType": "Condition",
        "id": "condition-3",
        "subject": {
          "reference": "Patient/patient-1"
        },
        "code": {
          "text": "Mild–moderate dementia, likely Alzheimer's type"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "note": [
          {
            "text": "Appears clinically stable today without acute change. Contributes to misinterpretation of bodily sensations and reliance on reassurance. Alzheimer's aetiology is described as likely."
          }
        ]
      }
    },
    {
