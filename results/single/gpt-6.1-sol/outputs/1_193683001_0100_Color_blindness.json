        "medicationCodeableConcept": {
          "text": "Hydrocortisone 1% cream"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "sequence": 1,
            "text": "Apply a thin layer to affected areas twice daily for 5–7 days, then once daily as settling. Maximum 2 weeks without review. Avoid face, groin and broken skin.",
            "route": {
              "text": "Topical"
            },
            "site": {
              "text": "Affected areas of the forearms"
            },
            "timing": {
              "repeat": {
                "frequency": 2,
                "period": 1,
                "periodUnit": "d"
              }
            }
          },
          {
            "sequence": 2,
            "text": "After the initial 5–7 days, apply a thin layer once daily as the rash settles; total course maximum 2 weeks without review.",
            "route": {
              "text": "Topical"
            },
            "site": {
              "text": "Affected areas of the forearms"
            },
            "timing": {
