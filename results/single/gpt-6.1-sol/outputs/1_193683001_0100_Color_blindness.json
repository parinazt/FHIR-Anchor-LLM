        "code": {
          "text": "Irritant contact dermatitis of both forearms"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "severity": {
          "text": "Mild to moderate"
        },
        "bodySite": [
          {
            "text": "Bilateral forearms"
          }
        ],
        "note": [
          {
            "text": "Likely occupational, associated with new industrial soap/cleaners and sweat/friction, with possible contributions from sun or fibreglass. Slightly improving with emollient and partial avoidance."
