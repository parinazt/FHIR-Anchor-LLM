        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Diarrhoea"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Loose watery stools began a few hours after nausea and vomiting; approximately 7–8 episodes in the last 24 hours, described as like water. No blood or mucus, rectal bleeding, or melaena."
      }
    },
