        "code": {
          "text": "Adjustment disorder with mixed anxiety and depressed mood"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
