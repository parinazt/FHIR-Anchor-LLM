        "code": {
          "text": "Reported mood and anxiety symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Still low in the evenings, tearful some nights, and worried about the future. Says she is doing alright, that other people have it worse, and that she does not want to be a bother.",
        "note": [
          {
            "text": "Seen approximately two weeks earlier for low mood, anxiety, and poor sleep following a breakup and housing/financial stress."
          }
        ]
      }
    },
