        "subject": {
          "reference": "Patient/patient-1"
        },
        "dosageInstruction": [
          {
            "text": "Apply a thin layer to hands, wrists, forearms and elbows nightly for 7–10 days, then on alternate nights for 1 week, then stop. Maximum once daily. Avoid face and groin. Do not use continuously for more than 2 weeks. Continue emollient.",
