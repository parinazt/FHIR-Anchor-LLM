        "code": {
          "text": "Non-cystic fibrosis bronchiectasis"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "onsetString": "Diagnosed by HRCT approximately 5 years ago",
        "bodySite": [
          {
            "text": "Right lower lobe"
          },
          {
            "text": "Lingula"
          }
        ],
        "note": [
          {
            "text": "Idiopathic bronchiectasis following recurrent pneumonias in her 50s. Previously managed by respiratory clinic; now GP-led care."
          },
          {
            "text": "Clinically stable. Persistent coarse bibasal crackles are consistent with known structural disease and baseline airway distortion with mucus plugging rather than a new parenchymal process. No current evidence of acute exacerbation."
          }
        ]
      }
    },
