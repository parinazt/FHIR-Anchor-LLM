        },
        "code": {
          "text": "Personality disorder, likely cluster B / borderline personality disorder traits"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "verificationStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
              "code": "provisional"
            }
          ]
        },
        "note": [
          {
            "text": "Previously told in his 20s that he had a 'personality disorder, kind of borderline'. Current assessment identifies contribution to impulsivity and emotional dysregulation."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-1",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-1",
        "status": "final",
        "code": {
          "text": "Reported gambling pattern and access"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Reports 'Pokies are running my life a bit'. Works in a pub gaming room with easy access. Uses electronic gaming machines most days, mainly at his own venue and sometimes a nearby club, with some late-night online sports betting. Ongoing for at least 12 months and worse after COVID reopening."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-2",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-2",
        "status": "final",
        "code": {
          "text": "Gambling preoccupation, impaired control and chasing losses"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Thinks about which machine is due even at dinner with his mother. Plans to spend $50 and be home by 9 pm but stays for hours and spends a few hundred dollars. Spent approximately $1200 over three nights last week. Believes 'one good night will fix it'."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-3",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-3",
        "status": "final",
        "code": {
          "text": "Financial and relational harms associated with gambling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Behind on credit card and Afterpay payments; has a small personal loan. Increased conflict with ex-partner regarding child support, and mother is pressuring him about money."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-4",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-4",
        "status": "final",
        "code": {
          "text": "Reduced recreational activity associated with gambling"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Has stopped gym and fishing activities, stating he would rather have the cash for a spin."
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-5",
