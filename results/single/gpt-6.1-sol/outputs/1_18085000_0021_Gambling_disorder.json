        "code": {
          "text": "Gambling disorder"
        },
        "clinicalStatus": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
              "code": "active"
            }
          ]
        },
        "severity": {
          "text": "Moderate–severe"
        },
        "note": [
          {
            "text": "Ongoing for at least 12 months, worse after COVID reopening. Preoccupation, impaired control, chasing losses, financial and relational harm, and continued gambling despite consequences. Employment in a gaming room and impulsive traits are major risk factors."
          }
        ]
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Condition/condition-2",
