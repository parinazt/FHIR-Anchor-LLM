      "resource": {
        "resourceType": "Observation",
        "id": "observation-5",
        "status": "final",
        "code": {
          "text": "Left lower leg pain symptoms"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "Chronic exertional compartment syndrome of left lower leg causing tightness 'like going to explode' after 20-30 minutes fast walking, heavy work, or stairs; settles after ~15 minutes rest with leg elevation; no pain at rest currently, a bit tight after busy week; denies numbness, weakness, colour change, fever, trauma, redness, or wounds; no features of acute compartment syndrome currently"
      }
    },
    {
      "fullUrl": "https://example.org/fhir/Observation/observation-6",
      "resource": {
        "resourceType": "Observation",
        "id": "observation-6",
        "status": "final",
        "code": {
          "text": "Left lower leg physical examination findings"
        },
        "subject": {
          "reference": "Patient/patient-1"
        },
        "valueString": "No obvious swelling, erythema, or deformity at rest; compartments soft; mild tenderness over anterior tibial area only; full ankle and toe range of motion; muscle power 5/5; sensation intact; dorsalis pedis and posterior tibial pulses palpable; capillary refill time less than 2 seconds; neuro exam grossly non-focal"
      }
    },
